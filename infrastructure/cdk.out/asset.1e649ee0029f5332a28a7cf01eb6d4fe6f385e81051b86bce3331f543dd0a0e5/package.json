{
  "name": "buta-avatar-handler",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "generate:openapi": "tsc && node -e \"const app=require('./dist/app').default;app.request('/doc').then(r=>r.json()).then(d=>{require('fs').writeFileSync('../../docs/openapi.json',JSON.stringify(d,null,2));console.log('Generated docs/openapi.json')})\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.810.0",
    "@aws-sdk/lib-dynamodb": "3.810.0",
    "@hono/zod-openapi": "^0.19.6",
    "hono": "^4.7.10",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/jest": "29.5.12",
    "@types/node": "22.15.0",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "clearMocks": true
  }
}
