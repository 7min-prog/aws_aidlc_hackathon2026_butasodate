{
  "name": "buta-mock-server",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "uuid": "11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.12",
    "@types/node": "22.15.0",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@types/ws": "^8.5.13",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.1.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
