        <mxCell id="e27" edge="1" source="lambda-avatar" target="ddb-skills" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Lambda Invoke: recording → avatar -->
        <mxCell id="e30" value="Lambda Invoke" style="strokeColor=#FF0000;strokeWidth=2;dashed=1;" edge="1" source="lambda-rec" target="lambda-avatar" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

