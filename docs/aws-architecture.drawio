        <mxCell id="ddb-evhist" value="DynamoDB&#xa;evolution-history" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
