        <mxCell id="e16" edge="1" source="cloudfront" target="s3-spa" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges: Lambda to DynamoDB -->
        <mxCell id="e20" edge="1" source="lambda-auth" target="cognito" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" edge="1" source="lambda-auth" target="ddb-profiles" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
