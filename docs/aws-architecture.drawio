        <mxCell id="ddb-freq" value="friend-requests" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="480" y="630" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Admin Stack -->
        <mxCell id="admin-group" value="ButaAdminStack" style="rounded=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#b85450;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="580" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value="CloudFront" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fillColor=#8C4FFF;strokeColor=#6b3dbf;" vertex="1" parent="1">
          <mxGeometry x="720" y="620" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3-spa" value="S3&#xa;admin-spa" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#3F8624;strokeColor=#2d6b1a;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="apigw-admin" value="API Gateway&#xa;/admin/*" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="850" y="620" width="50" height="50" as="geometry" />
