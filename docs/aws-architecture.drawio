        <mxCell id="s3-assets" value="S3&#xa;assets" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fillColor=#3F8624;strokeColor=#2d6b1a;" vertex="1" parent="1">
          <mxGeometry x="960" y="430" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- Battle/Social Stack -->
        <mxCell id="battle-group" value="ButaBattleSocialStack" style="rounded=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="640" height="320" as="geometry" />
        </mxCell>
        <mxCell id="apigw-ws" value="API Gateway&#xa;WebSocket" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda-battle" value="Lambda&#xa;battle-ws-handler" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="140" y="520" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="apigw-social" value="API Gateway&#xa;/social/* /rankings/*&#xa;/battles/*" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="360" y="520" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda-social" value="Lambda&#xa;social-handler" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ddb-conn" value="connections" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ddb-queue" value="match-queue" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
