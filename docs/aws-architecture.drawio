        <mxCell id="avatar-group" value="ButaAvatarStack" style="rounded=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="apigw-avatar" value="API Gateway&#xa;/avatar/*" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="720" y="240" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda-avatar" value="Lambda&#xa;avatar-handler" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="830" y="240" width="50" height="50" as="geometry" />
