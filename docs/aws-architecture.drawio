        <mxCell id="ddb-audit" value="DynamoDB&#xa;audit-log" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="850" y="720" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ddb-gameconfig" value="DynamoDB&#xa;game-config" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="960" y="720" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- Edges: Client to API Gateways -->
        <mxCell id="e1" edge="1" source="flutter" target="apigw-auth" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" source="flutter" target="apigw-rec" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" source="flutter" target="apigw-avatar" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
