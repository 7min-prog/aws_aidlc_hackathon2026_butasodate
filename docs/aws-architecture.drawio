<mxfile host="app.diagrams.net">
  <diagram name="AWS Architecture" id="aws-arch">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Client -->
        <mxCell id="client-group" value="Client" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="flutter" value="Flutter App&#xa;(iOS / Android)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.mobile_client;fillColor=#D5E8D4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="50" y="55" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="admin-spa" value="管理画面 SPA&#xa;(React)" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.client;fillColor=#DAE8FC;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="55" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Auth Stack -->
        <mxCell id="auth-group" value="ButaAuthStack" style="rounded=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#d6b656;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="200" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="apigw-auth" value="API Gateway&#xa;/auth/* /users/* /account" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda-auth" value="Lambda&#xa;auth-handler" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Cognito&#xa;User Pool" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="240" y="240" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ddb-profiles" value="DynamoDB&#xa;user-profiles" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="130" y="340" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- Recording Stack -->
        <mxCell id="rec-group" value="ButaRecordingStack" style="rounded=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="300" height="220" as="geometry" />
        </mxCell>
        <mxCell id="apigw-rec" value="API Gateway&#xa;/activities/* /categories/*" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda-rec" value="Lambda&#xa;recording-handler" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
          <mxGeometry x="480" y="240" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ddb-activities" value="DynamoDB&#xa;activity-records" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="380" y="340" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ddb-categories" value="DynamoDB&#xa;activity-categories" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="480" y="340" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ddb-healthsync" value="DynamoDB&#xa;health-sync-records" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="50" height="50" as="geometry" />
