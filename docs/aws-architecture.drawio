        <mxCell id="lambda-admin" value="Lambda&#xa;admin-handler" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fillColor=#F58534;strokeColor=#c9510c;" vertex="1" parent="1">
