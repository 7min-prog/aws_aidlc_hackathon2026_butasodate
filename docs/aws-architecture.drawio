        <mxCell id="ddb-friends" value="friends" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fillColor=#3F48CC;strokeColor=#2d3ab5;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="40" height="40" as="geometry" />
