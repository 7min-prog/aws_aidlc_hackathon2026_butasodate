#!/bin/sh
# Pre-push hook: 全バックエンドテストが通過しないとpushをブロック
set -e

echo "🧪 Running pre-push tests..."

FAILED=0

for handler in backend/auth-handler backend/recording-handler backend/avatar-handler; do
  if [ -d "$handler" ] && [ -f "$handler/package.json" ]; then
    echo "  Testing $handler..."
    (cd "$handler" && npx jest --no-coverage --silent) || FAILED=1
  fi
done

if [ $FAILED -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All tests passed. Pushing..."
